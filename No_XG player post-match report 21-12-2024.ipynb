   "source": [
    "#get match ids\n",
    "match_id=[]\n",
    "match_description=[]\n",
    "teams_id_name=[]\n",
    "\n",
    "\n",
    "match_info = result_dict['matchInfo']\n",
    "\n",
    "match_id.append(match_info['id'])\n",
    "match_description.append(match_info['description'])\n",
    "teams = match_info['contestant']\n",
    "teams_id_name.append({\n",
    "    'team1_id':teams[0]['id'],\n",
    "    'team1_name':teams[0]['name'],\n",
    "    'team2_id':teams[1]['id'],\n",
    "    'team2_name':teams[1]['name']\n",
    "    \n",
    "})\n",
    "#match_date = match_info['date']\n",
    "#match_time = match_info['time']\n",
    "\n",
    "\n",
    "\n",
    "# Assuming 't' is your original DataFrame\n",
    "t = pd.DataFrame(teams_id_name)\n",
    "\n",
    "# Extract 'team1_id' and 'team2_id' columns\n",
    "t3 = pd.Series(t['team1_id'])\n",
    "t4 = pd.Series(t['team2_id'])\n",
    "\n",
    "# Concatenate the two Series into a DataFrame\n",
    "tt = pd.concat([t3, t4], ignore_index=True)\n",
    "\n",
    "# Extract 'team1_name' and 'team2_name' columns\n",
    "t1 = pd.Series(t['team1_name'])\n",
    "t2 = pd.Series(t['team2_name'])\n",
    "\n",
    "# Concatenate the two Series into a DataFrame\n",
    "tt2 = pd.concat([t1, t2], ignore_index=True)\n",
    "\n",
    "# Create a new DataFrame with unique contestant IDs and names\n",
    "league_teams_ids_names = pd.DataFrame({\n",
    "    'contestantId': tt.unique(),\n",
    "    'contestantName': tt2.unique()\n",
    "})\n",
    "\n",
    "# Display the new DataFrame\n",
    "league_teams_ids_names\n",
    "\n",
    "\n",
    "match_id_description=pd.DataFrame(\n",
    "    {\n",
    "        'matchId':match_id,\n",
    "        'matchDescription':match_description\n",
    "    }\n",
    ")\n",
    "\n",
    "\n",
    "##Periods\n",
    "periods=pd.DataFrame({\n",
    "    'periodId':[14,16,1,2,3,4],\n",
    "    'period/displayName':['PostGame','PreMatch','FirstHalf','SecondHalf','FirstExtraTime','SecondExtraTime']\n",
    "})\n",
    "\n",
    "teams_id_name\n",
    "\n",
    "\n",
    "# Get match events\n",
    "match_url=[]\n",
    "all_events=[]\n",
    "\n",
    "\n",
    "f=response.text.split('\"liveData\":')[1][:-2]\n",
    "#print(type(f))\n",
    "data = json.loads(f)    #convert to dict\n",
    "#print(type(data))\n",
    "#print(data.keys())\n",
    "#print(data['event'])\n",
    "#d=list(data)\n",
    "events=pd.DataFrame(data['event'])\n",
    "events=pd.merge(events,league_teams_ids_names,on='contestantId',how='inner')\n",
    "events['matchId']=match_id_description['matchId']\n",
    "events['matchDescription']=match_id_description['matchDescription']\n",
    "events=pd.merge(events,periods,on='periodId',how='inner')\n",
