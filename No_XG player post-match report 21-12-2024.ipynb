   "source": [
    "\n",
    "# Your R code as a string\n",
    "r_code = \"\"\"\n",
    "\n",
    "\n",
    "sapply(data.source.xls, class)\n",
    "data.source.xls[\"endX\"]=as.numeric(unlist(data.source.xls[\"endX\"]))\n",
    "data.source.xls[\"endY\"]=as.numeric(unlist(data.source.xls[\"endY\"]))\n",
    "data.source.xls[\"goalMouthZ\"]=as.numeric(unlist(data.source.xls[\"goalMouthZ\"]))\n",
    "data.source.xls[\"goalMouthY\"]=as.numeric(unlist(data.source.xls[\"goalMouthY\"]))\n",
    "sapply(data.source.xls, class)\n",
    "\n",
    "player_id='d136eviplr7d6lirvse56m8yx'                             ########################################################################\n",
    "\n",
    "teams_names=data.source.xls['matchDescription']%>%filter(!is.na(matchDescription))\n",
    "team_split <- teams_names %>%\n",
    "  separate(matchDescription, into = c(\"team1\", \"team2\"), sep = \" vs \")\n",
    "teams_names=t(team_split)\n",
    "\n",
    "\n",
    "\n",
    "player_team=unique(data.source.xls%>% filter(`playerId`==player_id)%>%select('teamName'))\n",
    "\n",
    "\n",
    "player_events=data.source.xls %>% \n",
    "  filter(  playerId== player_id)%>% select (`type/displayName`,`outcomeType/displayName`,periodId,minute,second,playerName)%>%arrange(periodId,minute,second)\n",
    "\n",
    "# Get Passes\n",
    "Passes=data.source.xls %>% \n",
    "  filter(`type/displayName`==\"Pass\" & playerId== player_id)\n",
    "\n",
    "SuccPasses  = data.source.xls %>% \n",
    "  filter(`type/displayName`==\"Pass\" &`outcomeType/displayName`==\"Successful\"& playerId==player_id )\n",
    "\n",
    "\n",
    "\n",
    "\n",
    "\n",
    "succ_passes_set <- data.source.xls %>%filter_all(any_vars(. %in% c('Corner taken', 'Free kick taken')))\n",
    "succ_passes_no_set <- data.source.xls %>% \n",
    "  filter(`type/displayName`==\"Pass\" &`outcomeType/displayName`==\"Successful\")\n",
    "\n",
    "succ_passes_no_set =anti_join(succ_passes_no_set, succ_passes_set, by = \"id\")\n",
    "\n",
    "\n",
    "AllEventsHome= data.source.xls %>% \n",
    "  filter(teamName==as.character(teams_names[1,] )) %>% \n",
    "  select(id,minute,second,teamName,teamId,playerName,playerId,x,y,endX,endY,`type/displayName`,`outcomeType/displayName`)\n",
    "\n",
    "AllEventsAway= data.source.xls %>% \n",
    "  filter(teamName==as.character(teams_names[2,] )) %>% \n",
    "  select(id,minute,second,teamName,teamId,playerName,playerId,x,y,endX,endY,`type/displayName`,`outcomeType/displayName`)\n",
    "\n",
    "\n",
    "recHomeName=data.frame(as.character(unlist(shift(AllEventsHome['playerName'],-1))))\n",
    "recAwayName=data.frame(as.character(unlist(shift(AllEventsAway['playerName'],-1))))\n",
    "\n",
    "recHomeId=data.frame(unlist(shift(AllEventsHome['playerId'],-1)))\n",
    "recAwayId=data.frame(unlist(shift(AllEventsAway['playerId'],-1)))\n",
    "\n",
    "AllEventsHome['recipient name']=recHomeName\n",
    "AllEventsAway['recipient name']=recAwayName\n",
    "\n",
    "AllEventsHome['recipient id']=recHomeId\n",
    "AllEventsAway['recipient id']=recAwayId\n",
    "\n",
    "SuccPassesHome=AllEventsHome%>%filter(`type/displayName`==\"Pass\" &`outcomeType/displayName`==\"Successful\" )\n",
    "\n",
    "SuccPassesAway=AllEventsAway%>%filter(`type/displayName`==\"Pass\" &`outcomeType/displayName`==\"Successful\" )\n",
    "\n",
    "\n",
    "player_succ_passes_no_set =  succ_passes_no_set %>% filter(playerId==player_id)\n",
    "\n",
    "PassesIntoFinalThird=player_succ_passes_no_set %>% filter(x<66.67&endX >= 66.67 )\n",
    "\n",
    "# Calculationg progressive Passes \n",
    "ppbegin = sqrt( (100-player_succ_passes_no_set [\"x\"])**2 + (50 - player_succ_passes_no_set [\"y\"])**2 )\n",
    "ppend = sqrt((100-player_succ_passes_no_set [\"endX\"])**2 + (50 - player_succ_passes_no_set [\"endY\"])**2 )\n",
    "\n",
    "ratio = ppend / ppbegin \n",
    "progressive= ratio %>% filter(ratio < 0.75)\n",
    "\n",
    "player_succ_passes_no_set [\"ppbegin\"]= sqrt( (100-player_succ_passes_no_set [\"x\"])**2 + (50 - player_succ_passes_no_set [\"y\"])**2 )\n",
    "player_succ_passes_no_set [\"ppend\"]= sqrt( (100-player_succ_passes_no_set [\"endX\"])**2 + (50 - player_succ_passes_no_set [\"endY\"])**2 )\n",
    "player_succ_passes_no_set [\"Ratio\"]= player_succ_passes_no_set [\"ppend\"]/player_succ_passes_no_set [\"ppbegin\"]\n",
    "\n",
    "vertical_distance = abs(player_succ_passes_no_set [\"endY\"] - player_succ_passes_no_set [\"y\"])\n",
    "\n",
    "ProgressivePasses =player_succ_passes_no_set  %>% filter( Ratio < 0.75 & vertical_distance >= 5)\n",
    "\n",
    "\n",
    "#get KEY Passes and Assists \n",
    "\n",
    "KeyPasses =data.source.xls%>%filter(playerId==player_id &`type/displayName`==\"Pass\"  & keyPass==1)\n",
    "Assists =data.source.xls%>%filter(playerId==player_id &`type/displayName`==\"Pass\" & assist ==1 ) \n",
    "\n",
    "\n",
    "# Sample counts (replace with actual counts)\n",
    "count_prog = count(ProgressivePasses)\n",
    "count_key_passes = count(KeyPasses)+count(Assists)\n",
    "count_Assists = count(Assists)\n",
    "\n",
    "\n",
    "\n",
    "# Create a list of annotations dynamically based on conditions\n",
    "passing_annotations <- list(\n",
    "  \n",
    "  annotate(\"text\", x = -5, y = 75,  colour=\"#EC313A\",size=5,label =str_glue(\"{count(SuccPasses)} / {count(Passes)} Successful Passes\") ),\n",
    "  annotate(\"text\", x = -10, y = 72, colour=\"#EC313A\",size=5,label =str_glue(\"{count(PassesIntoFinalThird)} Successful Passes into final 1/3\")),\n",
    "  \n",
    "  \n",
    "  if (count_prog$n > 0)     annotate(\"text\", x = -5, y = 18 ,colour=\"white\",size=5,label =str_glue(\"{count(ProgressivePasses)} Progressive Passes\")),\n",
    "  \n",
    "  if (count_key_passes$n > 0 & count_prog$n > 0 ) annotate(\"text\", x = -10, y = 18 ,colour=\"#3d85c6\",size=5,label =str_glue(\"{count(KeyPasses) + count(Assists)} Key Passes\")),\n",
    "  if (count_key_passes$n > 0 & count_prog$n == 0) annotate(\"text\", x = -5,  y = 18 ,colour=\"#3d85c6\",size=5,label =str_glue(\"{count(KeyPasses) + count(Assists)} Key Passes\")),\n",
    "  \n",
    "  if (count_Assists$n > 0 & count_key_passes$n > 0 & count_prog$n > 0) annotate(\"text\", x = -15, y = 20, colour=\"#3fcf5d\",size=5,label =str_glue (\"{count(Assists)} Assists\")),\n",
    "  if (count_Assists$n > 0 & count_key_passes$n == 0 & count_prog$n > 0) annotate(\"text\", x = -10, y = 20, colour=\"#3fcf5d\",size=5,label =str_glue (\"{count(Assists)} Assists\")),\n",
    "  if (count_Assists$n > 0 & count_key_passes$n == 0 & count_prog$n == 0) annotate(\"text\", x = -5, y = 20, colour=\"#3fcf5d\",size=5,label =str_glue (\"{count(Assists)} Assists\"))\n",
    ")\n",
    "\n",
    "#=========================================================================================\n",
    "\n",
    "#get Defensive actions\n",
    "\n",
    "uAerial = data.source.xls %>% \n",
    "  filter(`type/displayName`==\"Aerial\" &playerId==player_id&`outcomeType/displayName`==\"Unsuccessful\" )\n",
    "\n",
    "\n",
    "uTackles= data.source.xls %>% \n",
    "  filter(`type/displayName`==\"Tackle\" & playerId== player_id &`outcomeType/displayName`==\"Unsuccessful\" )\n",
    "\n",
    "\n",
    "sdef=data.source.xls %>% filter((`type/displayName`==\"Tackle\"|`type/displayName`==\"Aerial\"|`type/displayName`==\"Ball recovery\"|`type/displayName`==\"Clearance\"|`type/displayName`==\"Interception\"|`type/displayName`==\"Blocked Pass\") & playerId==player_id&`outcomeType/displayName`==\"Successful\")\n",
    "\n",
    "sdef = sdef %>% rename('type'=`type/displayName`)\n",
    "\n",
    "sdef=sdef%>%select(type,playerName,x,y,endX,endY)\n",
    "\n",
    "LastManTackle=sdef%>% filter_all(any_vars(. %in% c('LastMan')))\n",
    "\n",
    "\n",
    "sdef_final=data.source.xls %>% filter((`type/displayName`==\"Tackle\"|`type/displayName`==\"Aerial\"|`type/displayName`==\"Ball recovery\"|`type/displayName`==\"Clearance\"|`type/displayName`==\"Interception\"|`type/displayName`==\"Blocked Pass\") &`outcomeType/displayName`==\"Successful\"&x<33.33&y<33.33)\n",
    "\n",
    "\n",
    "# Sample counts (replace with actual counts)\n",
    "count_aerials = count(data.source.xls %>% filter(`type/displayName` == 'Aerial'& playerId==player_id)) #all areials \n",
    "count_ball_recoveries = count(sdef %>% filter(`type` == 'Ball recovery'))\n",
    "count_clearances = count(sdef %>% filter(`type` == 'Clearance'))\n",
    "count_blocked_interceptions = count(sdef %>% filter(`type` %in% c('Blocked pass', 'Interception')))\n",
    "count_tackles = count(data.source.xls %>% filter(`type/displayName` == 'Tackle'& playerId==player_id))  #all tackles\n",
    "count_last_man_tackle = count(sdef %>% filter(`type` == 'Last Man tackle'))\n",
    "\n",
    "\n",
    "count(sdef%>%filter(type=='Aerial'))\n",
    "# Create a list of annotations dynamically based on conditions\n",
    "defensive_annotations <- list(\n",
    "  if (count_aerials$n > 0 ) annotate(\"text\", x = -5, y = 80, colour = \"#8973ca\", size = 5.50, label = str_glue(\"{count(sdef%>%filter(type=='Aerial'))}/{count_aerials$n} Aerials won\")),\n",
    "  \n",
    "  if (count_ball_recoveries$n > 0 & count_aerials$n > 0 ) annotate(\"text\", x = -10, y = 82, colour = \"#EB6440\", size = 5.50, label = str_glue(\"{count_ball_recoveries$n} Ball Recoveries\")),\n",
    "  if (count_ball_recoveries$n > 0 & count_aerials$n == 0) annotate(\"text\", x = -5, y = 82, colour = \"#EB6440\", size = 5.50, label = str_glue(\"{count_ball_recoveries$n} Ball Recoveries\")),\n",
    "  \n",
    "  if (count_clearances$n > 0 & count_aerials$n > 0 & count_ball_recoveries$n > 0) annotate(\"text\", x = -15, y = 82, colour = \"#3fcf5d\", size = 5.50, label = str_glue(\"{count_clearances$n} Clearances\")),\n",
    "  if (count_clearances$n > 0 & count_aerials$n == 0 & count_ball_recoveries$n > 0) annotate(\"text\", x = -10, y = 82, colour = \"#3fcf5d\", size = 5.50, label = str_glue(\"{count_clearances$n} Clearances\")),\n",
    "  if (count_clearances$n > 0 & count_aerials$n == 0 & count_ball_recoveries$n == 0) annotate(\"text\", x = -5, y = 82, colour = \"#3fcf5d\", size = 5.50, label = str_glue(\"{count_clearances$n} Clearances\")),\n",
    "  \n",
    "  \n",
    "  if (count_blocked_interceptions$n > 0) annotate(\"text\", x = -5, y = 25, colour = \"#FCE700\", size = 5.50, label = str_glue(\"{count_blocked_interceptions$n} Blocked pass & Interceptions\")),\n",
    "  \n",
    "  if (count_tackles$n > 0 & count_blocked_interceptions$n > 0) annotate(\"text\", x = -10, y = 20, colour = \"#25b5af\", size = 5.50, label = str_glue(\"{count(sdef%>%filter(`type`=='Tackle'))}/{count_tackles} Successful Tackles\")),\n",
    "  if (count_tackles$n > 0 & count_blocked_interceptions$n == 0) annotate(\"text\", x = -5, y = 20, colour = \"#25b5af\", size = 5.50, label = str_glue(\"{count(sdef%>%filter(`type`=='Tackle'))}/{count_tackles} Successful Tackles\")),\n",
    "  \n",
    "  if (count_last_man_tackle$n > 0 & count_tackles$n > 0 & count_blocked_interceptions$n > 0) annotate(\"text\", x = -15, y = 23, colour = \"#CF0A0A\", size = 5.50, label = \"Last Man tackle\"),\n",
    "  if (count_last_man_tackle$n > 0 & count_tackles$n == 0 & count_blocked_interceptions$n > 0) annotate(\"text\", x = -10, y = 23, colour = \"#CF0A0A\", size = 5.50, label = \"Last Man tackle\"),\n",
    "  if (count_last_man_tackle$n > 0 & count_tackles$n == 0 & count_blocked_interceptions$n == 0) annotate(\"text\", x = -5, y = 23, colour = \"#CF0A0A\", size = 5.50, label = \"Last Man tackle\")\n",
    ")\n",
    "\n",
