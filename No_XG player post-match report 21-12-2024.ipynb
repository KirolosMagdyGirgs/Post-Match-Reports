    "    sub_dfs=rbind.data.frame(sub_dfs, data.frame(df1[i:(i+10),c(\"id\",\"minute\",\"second\",\"type.displayName\",\"teamName\",\"x\",\"y\")]))\n",
    "    \n",
    "    if ( ( \"Miss\" %in% df1[(i+1):(i+10), \"type.displayName\"] |\"Attempt saved\" %in% df1[(i+1):(i+10), \"type.displayName\"] \n",
    "           |\"Post\" %in% df1[(i+1):(i+10), \"type.displayName\"] |\"Goal\" %in% df1[(i+1):(i+10), \"type.displayName\"])\n",
    "         &as.character(teams_names[1,]) %in% df1[(i+1):(i+10), \"teamName\"] &as.character(teams_names[1,])%in% df1[(i), \"teamName\"]) {\n",
    "      # If the condition is satisfied, print the index of the row\n",
    "      row_to_add <- data.frame(df1[i, c(\"id\", \"teamName\",\"x\",\"y\")])%>% filter(x>=66.67)\n",
    "      home_rec_led_to_shots <- rbind(home_rec_led_to_shots, row_to_add )    }\n",
    "  }\n",
    "  \n",
    "}\n",
