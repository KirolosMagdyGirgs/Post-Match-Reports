    "#Passing networks \n",
    "r_code='''\n",
    "#+==========================================================================================================================\n",
    "#Passing Network \n",
    "#home\n",
    "ggplot()+\n",
    "  annotate_pitch(fill = \"grey15\", colour = \"white\") +\n",
    "  geom_segment(data = pmh ,colour=\"white\",aes(x = x, y = y, xend = end_x, yend = end_y,alpha=between_count),size =3)+\n",
    "  #arrow = arrow(length = unit(0.25, \"cm\"), type = \"closed\"), alpha=0.3,arrow.fill = \"transparent\",lineend = \"round\") +\n",
    "  geom_point(data = AvgPosHome, aes(x = x, y = y,size=passes_count),colour=\"white\",fill=home_team_color,shape=21,stroke=3) +\n",
    "  \n",
    "  scale_size(range=c(5,15),breaks = c(20,40,60,80))+\n",
    "  scale_y_reverse()+\n",
    "  coord_flip()+\n",
    "  scale_x_continuous(limits =c(-20, 102) )+\n",
    "  theme_pitch(aspect_ratio = 105/68) +   \n",
    "  theme(legend.position = \"none\",plot.title = element_text(size=18,colour = \"white\", face='bold'),panel.background = element_rect(fill = \"grey15\") , plot.background = element_rect(fill = \"grey15\"), title = element_text(colour = \"white\",size=15))+\n",
    "  direction_label(colour = \"white\",text_size = 0)+\n",
    "  labs( title = str_glue( \"{teams_names[1,]} Passing Network\" )) +\n",
    "  \n",
    "  geom_label_repel(data = unique(AvgPosHome%>%select('playerName',short,x,y)) , aes(x, y, label=short), box.padding = 0.70, size = 4, col=\"white\", fill=\"grey15\", alpha=0.6, min.segment.length = 2) +\n",
    "  \n",
    "  annotate(\"text\", x = -5, y = 100,hjust = \"left\", colour=\"white\",size=6,label =str_glue(\"Most passes -> {head(pmh%>%filter(pmh['pass_count']==max(as.numeric(unlist(pmh['pass_count'])))),1)['playerName']} : {head(pmh%>%filter(pmh['pass_count']==max(as.numeric(unlist(pmh['pass_count'])))),1)['pass_count']} \") , fill = \"#EF0107\")+\n",
    "  #annotate(\"text\", x = -5, y = 49,hjust = \"left\",colour=\"white\",size=6,label =str_glue(\"{head(pmh%>%filter(pmh['pass_count']==max(as.numeric(unlist(pmh['pass_count'])))),1)['playerName']} : {head(pmh%>%filter(pmh['pass_count']==max(as.numeric(unlist(pmh['pass_count'])))),1)['pass_count']} \") )+\n",
    "  \n",
    "  annotate(\"text\", x = -10, y = 100,hjust = \"left\", colour=\"white\",size=6,label =str_glue(\"Most Receipts -> {head(MostRecipientsHome%>%filter(MostRecipientsHome['count']==max(as.numeric(unlist(count)))),1)['recipient name']} : {head(MostRecipientsHome%>%filter(MostRecipientsHome['count']==max(as.numeric(unlist(count)))),1)['count']}\"),fill=\"#EF0107\")+\n",
    "  #annotate(\"text\", x = -10, y = 49,hjust = \"left\", colour=\"white\",size=6,label =str_glue(\"{head(MostRecipientsHome%>%filter(MostRecipientsHome['count']==max(as.numeric(unlist(count)))),1)['recipient name']} : {head(MostRecipientsHome%>%filter(MostRecipientsHome['count']==max(as.numeric(unlist(count)))),1)['count']} \"))+\n",
    "  \n",
    "  annotate(\"text\", x = -15, y = 100,hjust = \"left\", colour=\"white\",size=6,label =str_glue(\"Most passes between -> \"),fill=\"#EF0107\")+\n",
    "  annotate(\"text\", x = -20, y = 100,hjust = \"left\", colour=\"white\",size=5,label =str_glue(\"{head(pmh%>%filter(pmh['between_count']==max(as.numeric(unlist(pmh['between_count'])))),1)['playerName']} -> {head(pmh%>%filter(pmh['between_count']==max(as.numeric(unlist(pmh['between_count'])))),1)['recipient name']} : {head(pmh%>%filter(pmh['between_count']==max(as.numeric(unlist(pmh['between_count'])))),1)['between_count']} \"))+\n",
    "  \n",
