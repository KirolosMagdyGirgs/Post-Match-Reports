    "    result.paste(im=image1, box=(0, 350))   #decide the \"start\" height of the imported photos \n",
    "    result.paste(im=image2, box=(width1, 350))\n",
    "    result.paste(im=image3, box=(width1+width2,350))\n",
    "    if os.path.exists(file4) : result.paste(im=image4, box=(4800,0 ))   \n",
    "    if os.path.exists(file5) : result.paste(im=image5, box=(5400,80 )) \n",
    "   # result.paste(im=image6,box=(4800,3100))\n",
    "\n",
