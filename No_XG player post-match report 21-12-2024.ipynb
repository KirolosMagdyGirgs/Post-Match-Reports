    "\n",
    "home_passes_into_pen=home_final_third_succ%>%filter(endX > 83 & endX < 100 & endY>100-87.8 & endY < 87.8 &!(x> 83 & x < 100 & y>10-87.8 & y < 87.8))\n",
    "\n",
    "\n",
    "home_key_passes =home_final_third_succ%>%filter(keyPass==1 )\n",
    "#Assists =KeyPasses%>% filter_all(any_vars(. %in% c('IntentionalGoalAssist')))\n",
    "\n",
    "home_assists =home_final_third_succ%>%filter(`type/displayName`==\"Pass\" & assist ==1 ) \n",
