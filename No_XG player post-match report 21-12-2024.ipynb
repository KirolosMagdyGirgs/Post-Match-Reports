    "  if(nrow(head(away_players_recovery,4))==1)   annotate(\"text\", x = c(-10), y = c(97),colour=\"white\",size=6,hjust=\"left\",label =str_glue(\"{head(away_players_recovery,4)$playerName} : {head(away_players_recovery,4)$Recoveries}\")),\n",
    "  if(nrow(head(away_players_recovery,4))==2)   annotate(\"text\", x = c(-10,-10), y = c(97,35),colour=\"white\",size=6,hjust=\"left\",label =str_glue(\"{head(away_players_recovery,4)$playerName} : {head(away_players_recovery,4)$Recoveries}\")),\n",
    "  if(nrow(head(away_players_recovery,4))==3)   annotate(\"text\", x = c(-10,-10,-15), y = c(97,35,97),colour=\"white\",hjust=\"left\",size=6,label =str_glue(\"{head(away_players_recovery,4)$playerName} : {head(away_players_recovery,4)$Recoveries}\")),\n",
    "  if(nrow(head(away_players_recovery,4))==4)   annotate(\"text\", x = c(-10,-10,-15,-15), y = c(97,35,97,35),colour=\"white\",hjust=\"left\",size=6,label =str_glue(\"{head(away_players_recovery,4)$playerName} : {head(away_players_recovery,4)$Recoveries}\"))\n",
    "  \n",
    "  \n",
    ")\n",
    "\n",
    "#===================================================================================================================================\n",
    "#Defensive actions zones \n",
    "\n",
    "home_defensive_actions = data.source.xls%>%filter(teamName==as.character(teams_names[1,])&(`type/displayName`==\"Tackle\"|`type/displayName`==\"Challenge\"|`type/displayName`==\"Aerial\"|`type/displayName`==\"Ball recovery\"\n",
    "                                                                                           |`type/displayName`==\"Clearance\"|`type/displayName`==\"Interception\"|`type/displayName`==\"Blocked pass\"\n",
    "                                                                                           |`type/displayName`==\"Foul\"))\n",
    "\n",
    "\n",
    "\n",
    "\n",
    "home_defensive_actions$xbin <- cut(home_defensive_actions$x, breaks = seq(from=0, to=100, by = 10),include.lowest=TRUE )\n",
    "home_defensive_actions$ybin <- cut(home_defensive_actions$y, breaks = seq(from=0, to=100, by = 10),include.lowest=TRUE )\n",
    "\n",
    "home_defensive_actions_zone_count= home_defensive_actions%>%group_by(xbin,ybin)%>%summarise(count=n())\n",
    "\n",
    "\n",
    "\n",
    "home_most_defensive_action_by_zone=home_defensive_actions%>% group_by(xbin, ybin, `type/displayName`) %>%\n",
    "  summarise(count = n()) %>%\n",
    "  group_by(xbin, ybin) %>%\n",
    "  arrange(desc(count)) %>%\n",
    "  slice(1) %>%\n",
    "  ungroup()\n",
    "\n",
    "home_defensive_actionsAvgX=mean(home_defensive_actions$x)\n",
    "home_defensive_actionsAvgY=mean(home_defensive_actions$y)\n",
    "#=========\n",
    "\n",
    "away_defensive_actions = data.source.xls%>%filter(teamName==as.character(teams_names[2,])&(`type/displayName`==\"Tackle\"|`type/displayName`==\"Challenge\"|`type/displayName`==\"Aerial\"|`type/displayName`==\"Ball recovery\"\n",
    "                                                                                           |`type/displayName`==\"Clearance\"|`type/displayName`==\"Interception\"|`type/displayName`==\"Blocked pass\"\n",
    "                                                                                           |`type/displayName`==\"Foul\"))\n",
    "\n",
    "\n",
    "\n",
    "\n",
    "away_defensive_actions$xbin <- cut(away_defensive_actions$x, breaks = seq(from=0, to=100, by = 10),include.lowest=TRUE )\n",
    "away_defensive_actions$ybin <- cut(away_defensive_actions$y, breaks = seq(from=0, to=100, by = 10),include.lowest=TRUE )\n",
    "\n",
    "away_defensive_actions_zone_count= away_defensive_actions%>%group_by(xbin,ybin)%>%summarise(count=n())\n",
    "\n",
    "\n",
    "\n",
    "away_most_defensive_action_by_zone=away_defensive_actions%>% group_by(xbin, ybin, `type/displayName`) %>%\n",
    "  summarise(count = n()) %>%\n",
    "  group_by(xbin, ybin) %>%\n",
    "  arrange(desc(count)) %>%\n",
    "  slice(1) %>%\n",
    "  ungroup()\n",
    "\n",
    "away_defensive_actionsAvgX=mean(away_defensive_actions$x)\n",
    "away_defensive_actionsAvgY=mean(away_defensive_actions$y)\n",
    "#================================================================================================================================\n",
    "#GKs passes\n",
    "home_team_squad=data.source.xls%>%filter(teamName==as.character(teams_names[1,]),`type/displayName`=='Team set up')\n",
    "# Get the column after the 'Involved' column\n",
    "column_after_involved <- home_team_squad[, (which(grepl('Involved', home_team_squad)) + 1)]\n",
    "home_gk_id=column_after_involved%>%separate(colnames(column_after_involved),sep = \",\", into = c(\"gk\") )\n",
    "home_gk_id=as.character(home_gk_id[1,'gk'])\n",
    "\n",
    "away_team_squad=data.source.xls%>%filter(teamName==as.character(teams_names[2,]),`type/displayName`=='Team set up')\n",
    "# Get the column after the 'Involved' column\n",
    "column_after_involved <- away_team_squad[, (which(grepl('Involved', away_team_squad)) + 1)]\n",
    "away_gk_id=column_after_involved%>%separate(colnames(column_after_involved),sep = \",\", into = c(\"gk\") )\n",
    "away_gk_id=as.character(away_gk_id[1,'gk'])\n",
    "\n",
    "home_gk_passes=data.source.xls %>% filter(`type/displayName`==\"Pass\" & playerId== home_gk_id )\n",
    "home_gk_succ_passes = home_gk_passes %>% filter(`type/displayName`==\"Pass\" & playerId== home_gk_id & outcome==1)\n",
    "home_gk_succ_passes_ift=home_gk_succ_passes %>% filter(x<66.67&endX >= 66.67 )\n",
    "home_gk_passes_key=home_gk_succ_passes%>%filter(keyPass==1)\n",
    "home_gk_passes_assist=home_gk_succ_passes%>%filter(assist==1)\n",
    "\n",
    "\n",
    "away_gk_passes=data.source.xls %>% filter(`type/displayName`==\"Pass\" & playerId== away_gk_id )\n",
    "away_gk_succ_passes = away_gk_passes %>% filter(`type/displayName`==\"Pass\" & playerId== away_gk_id & outcome==1)\n",
    "away_gk_succ_passes_ift=away_gk_succ_passes %>% filter(x<66.67&endX >= 66.67 )\n",
    "away_gk_passes_key=away_gk_succ_passes%>%filter(keyPass==1)\n",
    "away_gk_passes_assist=away_gk_succ_passes%>%filter(assist==1)\n",
    "\n",
    "\n",
    "\n",
    "home_gk_passing_annotations <- list(\n",
    "  \n",
    "  annotate(\"text\", x = -5, y = 75,  colour=\"#EC313A\",size=5,label =str_glue(\"{count(home_gk_succ_passes)} / {count(home_gk_passes)} Successful Passes\") ),\n",
    "  annotate(\"text\", x = -10, y = 72, colour=\"#EC313A\",size=5,label =str_glue(\"{count(home_gk_succ_passes_ift)} Successful Passes into final 1/3\")),\n",
    "  \n",
    "  \n",
    "  \n",
    "  if (count(home_gk_passes_key) > 0) annotate(\"text\", x = -5,  y = 18 ,colour=\"#3d85c6\",size=5,label =str_glue(\"{count(home_gk_passes_key) + count(home_gk_passes_assist)} Key Passes\")),\n",
    "  \n",
    "  if (count(home_gk_passes_assist) > 0 & count(home_gk_passes_key)> 0 ) annotate(\"text\", x = -10, y = 20, colour=\"#3fcf5d\",size=5,label =str_glue (\"{count(home_gk_passes_assist)} Assists\")),\n",
    "  if (count(home_gk_passes_assist) > 0 & count(home_gk_passes_key) == 0 ) annotate(\"text\", x = -5, y = 20, colour=\"#3fcf5d\",size=5,label =str_glue (\"{count(home_gk_passes_assist)} Assists\"))\n",
    ")\n",
    "\n",
    "\n",
    "away_gk_passing_annotations <- list(\n",
    "  \n",
    "  annotate(\"text\", x = -5, y = 75,  colour=\"#EC313A\",size=5,label =str_glue(\"{count(away_gk_succ_passes)} / {count(away_gk_passes)} Successful Passes\") ),\n",
    "  annotate(\"text\", x = -10, y = 72, colour=\"#EC313A\",size=5,label =str_glue(\"{count(away_gk_succ_passes_ift)} Successful Passes into final 1/3\")),\n",
    "  \n",
    "  \n",
    "  \n",
    "  if (count(away_gk_passes_key) > 0) annotate(\"text\", x = -5,  y = 18 ,colour=\"#3d85c6\",size=5,label =str_glue(\"{count(away_gk_passes_key) + count(away_gk_passes_assist)} Key Passes\")),\n",
    "  \n",
    "  if (count(away_gk_passes_assist) > 0 & count(away_gk_passes_key)> 0 ) annotate(\"text\", x = -10, y = 20, colour=\"#3fcf5d\",size=5,label =str_glue (\"{count(away_gk_passes_assist)} Assists\")),\n",
    "  if (count(away_gk_passes_assist) > 0 & count(away_gk_passes_key) == 0 ) annotate(\"text\", x = -5, y = 20, colour=\"#3fcf5d\",size=5,label =str_glue (\"{count(away_gk_passes_assist)} Assists\"))\n",
    ")\n",
    "#===========================================================================================================================\n",
    "\n",
    "\n",
    "#=============================================================================================================================\n",
    "#Carries and take-ons \n",
    "\n",
    "dribbles = data.source.xls%>% filter(`type/displayName`== 'Take on' & playerId==player_id)%>%select(id,minute,second,playerName,x,y,'type/displayName','outcomeType/displayName')\n",
    "colnames(dribbles)[which(names(dribbles)==\"outcomeType/displayName\")]<-\"outcome\"\n",
    "\n",
    "dribbles\n",
    "aeh= data.source.xls %>% \n",
    "  filter(teamName==as.character(teams_names[1,] )) %>% \n",
    "  select(periodId,id,minute,second,teamName,teamId,playerName,playerId,x,y,endX,endY,`type/displayName`,`outcomeType/displayName`)\n",
    "\n",
    "aea= data.source.xls %>% \n",
    "  filter(teamName==as.character(teams_names[2,] )) %>% \n",
    "  select(periodId,id,minute,second,teamName,teamId,playerName,playerId,x,y,endX,endY,`type/displayName`,`outcomeType/displayName`)\n",
    "\n",
    "\n",
    "aeh=aeh%>%arrange(periodId,minute,second)\n",
    "aea=aea%>%arrange(periodId,minute,second)\n",
    "\n",
    "\n",
    "recHomeName=data.frame(as.character(unlist(shift(aeh['playerName'],-1))))\n",
    "recAwayName=data.frame(as.character(unlist(shift(aea['playerName'],-1))))\n",
    "\n",
    "recHomeId=data.frame(unlist(shift(aeh['playerId'],-1)))\n",
    "recAwayId=data.frame(unlist(shift(aea['playerId'],-1)))\n",
    "\n",
    "aeh['recipient name']=recHomeName\n",
    "aea['recipient name']=recAwayName\n",
    "\n",
    "aeh['recipient id']=recHomeId\n",
    "aea['recipient id']=recAwayId\n",
    "\n",
    "\n",
    "\n",
    "if (player_team == as.character(teams_names[1,])) {\n",
    "  a=aeh%>%mutate(current_event=((`type/displayName`==\"Pass\" &`outcomeType/displayName`==\"Successful\" &`recipient id`==player_id & playerId!= `recipient id`&!is.na(`recipient id`))\n",
    "                                |(`type/displayName`==\"Ball recovery\"&playerId==player_id)|\n",
    "                                  (`type/displayName`==\"Take on\" &`outcomeType/displayName`==\"Successful\" &playerId==player_id)))\n",
    "  \n",
    "  \n",
    "} else {\n",
    "  a=aea%>%mutate(current_event=((`type/displayName`==\"Pass\" &`outcomeType/displayName`==\"Successful\" &aea['recipient id']==player_id & playerId!= aea['recipient id']&!is.na(`recipient id`))\n",
    "                                |(`type/displayName`==\"Ball recovery\"&playerId==player_id)|\n",
    "                                  (`type/displayName`==\"Take on\" &`outcomeType/displayName`==\"Successful\" &playerId==player_id)))\n",
    "  \n",
    "}\n",
    "\n",
    "\n",
    "nrow(a%>%filter(current_event==TRUE))\n",
    "b=a%>%mutate(next_event=lag(current_event==TRUE))\n",
    "nrow(b%>%filter(next_event==TRUE))\n",
    "c=b%>%mutate(nne=(next_event==TRUE& \n",
    "                    (`type/displayName`==\"Pass\" |`type/displayName`==\"Miss\"|`type/displayName`==\"Attempt saved\"|\n",
    "                       `type/displayName`==\"Post\"|`type/displayName`==\"Goal\"|`type/displayName`==\"Take on\"|`type/displayName`==\"Ball touch\") ))\n",
    "\n",
    "\n",
    "\n",
    "\n",
    "nrow(c%>%filter(nne==TRUE))\n",
    "tt=c%>%filter(nne==TRUE)\n",
    "#c=b%>%mutate(nne=mutate(next_event==TRUE &(`type/displayName`==\"Pass\" |`type/displayName`==\"TakeOn\"|`type/displayName`==\"MissedShots\"|`type/displayName`==\"SavedShot\"|`type/displayName`==\"ShotOnPost\"|`type/displayName`==\"Goal\") ))\n",
    "\n",
    "#d=d[-5,]\n",
    "\n",
    "\n",
    "\n",
    "new_row=data.frame()\n",
    "Carries=data.frame()\n",
    "for (i in 1:(nrow(c))) {\n",
    "  \n",
    "  for(j in i){\n",
    "    if (c$current_event[j ]==TRUE && c$nne[j + 1] == TRUE) {\n",
    "      new_row <- c[j, ]\n",
    "      new_row2 <- c[j+1, ]\n",
    "      Carries <- rbind(Carries, new_row,new_row2)\n",
    "    }\n",
    "  }\n",
    "}\n",
    "\n",
    "Carries$test=rep(c(\"first\", \"second\"), each = 1,times=nrow(Carries)/2)\n",
    "#giving ball recovery endx and endy because they are null\n",
    "Carries$endX=ifelse(Carries$`type/displayName`=='Ball recovery',Carries$x,Carries$endX)\n",
    "Carries$endY=ifelse(Carries$`type/displayName`=='Ball recovery',Carries$y,Carries$endY)\n",
    "Carries$endX=ifelse(Carries$`type/displayName`=='Ball touch',Carries$x,Carries$endX)\n",
    "Carries$endY=ifelse(Carries$`type/displayName`=='Ball touch',Carries$y,Carries$endY)\n",
    "Carries$endX=ifelse(Carries$`type/displayName`=='Take on',Carries$x,Carries$endX)\n",
    "Carries$endY=ifelse(Carries$`type/displayName`=='Take on',Carries$y,Carries$endY)\n",
    "\n",
    "#carry start point is endx and endy of current_event ==T(ball reciption or ball recovery) \n",
    "c1=Carries%>%filter(test==\"first\")\n",
    "# result data endX and endY is the start point of the carry where x and y are end points \n",
    "Carries=Carries%>%filter(test==\"second\")\n",
    "Carries$endX=c1$endX\n",
    "Carries$endY=c1$endY\n",
    "\n",
    "calculate_distance <- function(x1, y1, x2, y2) {\n",
    "  sqrt((x1 - x2)^2 + (y1 - y2)^2)\n",
    "}\n",
    "\n",
    "\n",
    "\n",
    "for (i in 1:(nrow(Carries))){\n",
    "  \n",
    "  \n",
    "  Carries$distance=(calculate_distance(Carries$endX,Carries$endY,Carries$x,Carries$y))\n",
    "}\n",
    "\n",
    "Carries=Carries%>%filter(distance>5)\n",
    "#endX is the start point\n",
    "\n",
    "CarriesIntoFinalThird=Carries %>% filter(endX<66.67 & x >= 66.67 )\n",
    "\n",
    "CarriesIntoBox = Carries%>% filter(x > 83 & x < 100 & y>100-78.8 & y < 78.8 )\n",
    "\n",
    "CarriesLedToShot = Carries%>%filter( `type/displayName`==\"Miss\"|`type/displayName`==\"Attempt saved\" |`type/displayName`==\"Post\"|`type/displayName`==\"Goal\")\n",
    "\n",
    "CarriesLedToGoal = Carries%>%filter( `type/displayName`==\"Goal\")\n",
    "\n",
    "# Calculationg progressive passes \n",
    "ppbegin = sqrt( (100-Carries [\"endX\"])**2 + (50 - Carries [\"endY\"])**2 )\n",
    "ppend = sqrt( (100-Carries [\"x\"])**2 + (50 - Carries [\"y\"])**2 )\n",
    "ratio = ppend / ppbegin \n",
    "progressive= ratio %>% filter(ratio < 0.75)\n",
    "\n",
    "Carries [\"ppbegin\"]= sqrt( (100-Carries [\"endX\"])**2 + (50 - Carries [\"endY\"])**2 )\n",
    "Carries [\"ppend\"]= sqrt( (100-Carries [\"x\"])**2 + (50 - Carries [\"y\"])**2 )\n",
    "Carries [\"Ratio\"]= Carries [\"ppend\"]/Carries [\"ppbegin\"]\n",
    "\n",
    "\n",
    "vertical_distance = abs(Carries [\"y\"] - Carries [\"endY\"])\n",
    "ProgressiveCarries =Carries  %>% filter( Ratio < 0.75 & vertical_distance >= 5)\n",
    "\n",
    "count_carries_led_to_shot=count(CarriesLedToShot)\n",
    "count_carries_led_to_goal=count(CarriesLedToGoal)\n",
    "count_progressive_carries=count(ProgressiveCarries)\n",
    "carries_annotations <- list(annotate(\"text\", x = -5, y = 50,vjust= 1,colour=\"#FF9800\",size=6,label = str_glue(\"{count(Carries)} Carries with distance > 5 m\")),\n",
    "                            if( count_carries_led_to_shot>0) annotate(\"text\", x = -10, y = 75,vjust= 1,colour=\"#3d85c6\",size=6,label = str_glue(\"{count(CarriesLedToShot)} led to shots\")),\n",
    "                            if(count_carries_led_to_goal>0) annotate(\"text\", x = -10, y = 20,vjust= 1,colour=\"#3fcf5d\",size=6,label = str_glue(\"{count(CarriesLedToGoal)} led to goals \")),\n",
    "                            if(count_progressive_carries>0) annotate(\"text\", x = -10, y = 45,vjust= 1,colour=\"white\",size=6,label = str_glue(\"{count(ProgressiveCarries)} Progressive \"))\n",
    ")\n",
    "#====================================================================================================================================\n",
    "#Box and Final third entries \n",
    "home_pass_into_final_3rd=home_succ_passes_no_set%>%filter(x<66.67,endX>66.67)\n",
    "away_pass_into_final_3rd=away_succ_passes_no_set%>%filter(x<66.67,endX>66.67)\n",
    "\n",
    "\n",
    "home_pass_into_box=home_succ_passes_no_set%>%filter(endX > 83 & endX < 100 & endY>100-78.8 & endY <78.8 &!(x> 83 & x < 100 & y>10-87.8 & y < 87.8) )\n",
    "away_pass_into_box=away_succ_passes_no_set%>%filter(endX > 83 & endX < 100 & endY>100-78.8 & endY <78.8 &!(x> 83 & x < 100 & y>10-87.8 & y < 87.8) )\n",
    "\n",
    "\n",
    "\n",
    "\n",
    "\n",
    "a=aeh%>%mutate(current_event=((`type/displayName`==\"Pass\" &`outcomeType/displayName`==\"Successful\" & playerId!= `recipient id`&!is.na(`recipient id`))\n",
    "                              |(`type/displayName`==\"Ball recovery\")|\n",
    "                                (`type/displayName`==\"Take on\" &`outcomeType/displayName`==\"Successful\" )))\n",
    "\n",
    "\n",
    "\n",
    "\n",
    "nrow(a%>%filter(current_event==TRUE))\n",
    "b=a%>%mutate(next_event=lag(current_event==TRUE))\n",
    "nrow(b%>%filter(next_event==TRUE))\n",
    "c=b%>%mutate(nne=(next_event==TRUE& \n",
    "                    (`type/displayName`==\"Pass\" |`type/displayName`==\"Miss\"|`type/displayName`==\"Attempt saved\"|\n",
    "                       `type/displayName`==\"Post\"|`type/displayName`==\"Goal\"|`type/displayName`==\"Take on\"|`type/displayName`==\"Ball touch\") ))\n",
    "\n",
    "\n",
    "\n",
    "\n",
    "nrow(c%>%filter(nne==TRUE))\n",
    "tt=c%>%filter(nne==TRUE)\n",
    "\n",
    "\n",
    "\n",
    "new_row=data.frame()\n",
    "home_carries_cif=data.frame()\n",
    "for (i in 1:(nrow(c))) {\n",
    "  \n",
    "  for(j in i){\n",
    "    if (c$current_event[j ]==TRUE && c$nne[j + 1] == TRUE) {\n",
    "      new_row <- c[j, ]\n",
    "      new_row2 <- c[j+1, ]\n",
    "      home_carries_cif <- rbind(home_carries_cif, new_row,new_row2)\n",
    "    }\n",
    "  }\n",
    "}\n",
    "\n",
    "home_carries_cif$test=rep(c(\"first\", \"second\"), each = 1,times=nrow(home_carries_cif)/2)\n",
    "#giving ball recovery endx and endy because they are null\n",
    "home_carries_cif$endX=ifelse(home_carries_cif$`type/displayName`=='Ball recovery',home_carries_cif$x,home_carries_cif$endX)\n",
    "home_carries_cif$endY=ifelse(home_carries_cif$`type/displayName`=='Ball recovery',home_carries_cif$y,home_carries_cif$endY)\n",
    "home_carries_cif$endX=ifelse(home_carries_cif$`type/displayName`=='Ball touch',home_carries_cif$x,home_carries_cif$endX)\n",
    "home_carries_cif$endY=ifelse(home_carries_cif$`type/displayName`=='Ball touch',home_carries_cif$y,home_carries_cif$endY)\n",
    "home_carries_cif$endX=ifelse(home_carries_cif$`type/displayName`=='Take on',home_carries_cif$x,home_carries_cif$endX)\n",
    "home_carries_cif$endY=ifelse(home_carries_cif$`type/displayName`=='Take on',home_carries_cif$y,home_carries_cif$endY)\n",
    "\n",
    "#carry start point is endx and endy of current_event ==T(ball reciption or ball recovery) \n",
    "c1=home_carries_cif%>%filter(test==\"first\")\n",
    "# result data endX and endY is the start point of the carry where x and y are end points \n",
    "home_carries_cif=home_carries_cif%>%filter(test==\"second\")\n",
    "home_carries_cif$endX=c1$endX\n",
    "home_carries_cif$endY=c1$endY\n",
    "\n",
    "calculate_distance <- function(x1, y1, x2, y2) {\n",
    "  sqrt((x1 - x2)^2 + (y1 - y2)^2)\n",
    "}\n",
    "\n",
    "\n",
    "\n",
    "for (i in 1:(nrow(home_carries_cif))){\n",
    "  \n",
    "  \n",
    "  home_carries_cif$distance=(calculate_distance(home_carries_cif$endX,home_carries_cif$endY,home_carries_cif$x,home_carries_cif$y))\n",
    "}\n",
    "\n",
    "home_carries_cif=home_carries_cif%>%filter(distance>5)\n",
    "#endX is the start point\n",
    "\n",
    "carries_cif_into_final_3rd=home_carries_cif %>% filter(endX<66.67 & x >= 66.67 )\n",
    "\n",
    "\n",
    "carries_cif_into_box= home_carries_cif%>% filter(x > 83 & x < 100 & y>100-78.8 & y < 78.8  &!(endX> 83 & x < 100 & endY>10-87.8 & endY < 87.8))\n",
    "home_carries_cif=carries_cif_into_final_3rd%>%filter(teamName==as.character(teams_names[1,]))\n",
    "home_carries_cib=carries_cif_into_box%>%filter(teamName==as.character(teams_names[1,]))\n",
    "\n",
    "\n",
    "#=================\n",
    "\n",
    "a=aea%>%mutate(current_event=((`type/displayName`==\"Pass\" &`outcomeType/displayName`==\"Successful\" & playerId!= `recipient id`&!is.na(`recipient id`))\n",
    "                              |(`type/displayName`==\"Ball recovery\")|\n",
    "                                (`type/displayName`==\"Take on\" &`outcomeType/displayName`==\"Successful\" )))\n",
    "\n",
    "\n",
    "\n",
    "\n",
    "nrow(a%>%filter(current_event==TRUE))\n",
    "b=a%>%mutate(next_event=lag(current_event==TRUE))\n",
    "nrow(b%>%filter(next_event==TRUE))\n",
    "c=b%>%mutate(nne=(next_event==TRUE& \n",
    "                    (`type/displayName`==\"Pass\" |`type/displayName`==\"Miss\"|`type/displayName`==\"Attempt saved\"|\n",
    "                       `type/displayName`==\"Post\"|`type/displayName`==\"Goal\"|`type/displayName`==\"Take on\"|`type/displayName`==\"Ball touch\") ))\n",
    "\n",
    "\n",
    "\n",
    "\n",
    "nrow(c%>%filter(nne==TRUE))\n",
    "tt=c%>%filter(nne==TRUE)\n",
    "\n",
    "\n",
    "\n",
    "new_row=data.frame()\n",
    "away_carries_cif=data.frame()\n",
    "for (i in 1:(nrow(c))) {\n",
    "  \n",
    "  for(j in i){\n",
    "    if (c$current_event[j ]==TRUE && c$nne[j + 1] == TRUE) {\n",
    "      new_row <- c[j, ]\n",
    "      new_row2 <- c[j+1, ]\n",
    "      away_carries_cif <- rbind(away_carries_cif, new_row,new_row2)\n",
    "    }\n",
    "  }\n",
    "}\n",
    "\n",
    "away_carries_cif$test=rep(c(\"first\", \"second\"), each = 1,times=nrow(away_carries_cif)/2)\n",
    "#giving ball recovery endx and endy because they are null\n",
    "away_carries_cif$endX=ifelse(away_carries_cif$`type/displayName`=='Ball recovery',away_carries_cif$x,away_carries_cif$endX)\n",
    "away_carries_cif$endY=ifelse(away_carries_cif$`type/displayName`=='Ball recovery',away_carries_cif$y,away_carries_cif$endY)\n",
    "away_carries_cif$endX=ifelse(away_carries_cif$`type/displayName`=='Ball touch',away_carries_cif$x,away_carries_cif$endX)\n",
    "away_carries_cif$endY=ifelse(away_carries_cif$`type/displayName`=='Ball touch',away_carries_cif$y,away_carries_cif$endY)\n",
    "away_carries_cif$endX=ifelse(away_carries_cif$`type/displayName`=='Take on',away_carries_cif$x,away_carries_cif$endX)\n",
    "away_carries_cif$endY=ifelse(away_carries_cif$`type/displayName`=='Take on',away_carries_cif$y,away_carries_cif$endY)\n",
    "\n",
    "#carry start point is endx and endy of current_event ==T(ball reciption or ball recovery) \n",
    "c1=away_carries_cif%>%filter(test==\"first\")\n",
    "# result data endX and endY is the start point of the carry where x and y are end points \n",
    "away_carries_cif=away_carries_cif%>%filter(test==\"second\")\n",
    "away_carries_cif$endX=c1$endX\n",
    "away_carries_cif$endY=c1$endY\n",
    "\n",
    "calculate_distance <- function(x1, y1, x2, y2) {\n",
    "  sqrt((x1 - x2)^2 + (y1 - y2)^2)\n",
    "}\n",
    "\n",
    "\n",
    "\n",
    "for (i in 1:(nrow(away_carries_cif))){\n",
    "  \n",
    "  \n",
    "  away_carries_cif$distance=(calculate_distance(away_carries_cif$endX,away_carries_cif$endY,away_carries_cif$x,away_carries_cif$y))\n",
    "}\n",
    "\n",
    "away_carries_cif=away_carries_cif%>%filter(distance>5)\n",
    "#endX is the start point\n",
    "\n",
    "carries_cif_into_final_3rd=away_carries_cif %>% filter(endX<66.67 & x >= 66.67 )\n",
    "\n",
    "\n",
    "carries_cif_into_box= away_carries_cif%>% filter(x > 83 & x < 100 & y>100-78.8 & y < 78.8  &!(endX> 83 & x < 100 & endY>10-87.8 & endY < 87.8))\n",
    "away_carries_cif=carries_cif_into_final_3rd%>%filter(teamName==as.character(teams_names[2,]))\n",
    "away_carries_cib=carries_cif_into_box%>%filter(teamName==as.character(teams_names[2,]))\n",
    "\n",
    "\"\"\"\n",
    "\n",
    "\n",
    "\n",
    "# Running R code\n",
    "robjects.r(r_code)\n",
    "\n",
    "\n"
   ]
  },
