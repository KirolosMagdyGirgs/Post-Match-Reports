    "  if(count(PlayerReceivedPassesInsideBox)>0)annotate(\"text\", x = -14, y = 20,vjust= 1,colour=\"white\",size=6,label = str_glue(\"{count(PlayerReceivedPassesInsideBox)} inside the box\"))\n",
