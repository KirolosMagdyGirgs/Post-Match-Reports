    "\n",
    "# Create a list to store the sub-data frames\n",
    "sub_dfs <- data.frame()\n",
    "coll <- c(\"id\",\"minute\",\"second\", \"type.displayName\", \"teamName\", \"x\", \"y\")\n",
    "home_rec_led_to_shots <- data.frame(matrix(nrow = 0, ncol = length(coll)))\n",
