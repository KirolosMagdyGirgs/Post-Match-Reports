    "home_unique_append$ybin <- cut(home_unique_append$y, breaks = home_breaking_points,include.lowest=TRUE )\n",
    "home_unique_append$x[home_unique_append$x>66.67] <- 66.67 \n",
    "home_unique_append$x[home_unique_append$x<100] <- 100 \n",
    "home_unique_append_zone_count= home_unique_append%>%group_by(ybin)%>%summarise(count=n())\n",
    "\n",
    "\n",
    "data.frame(home_unique_append_zone_count)%>%filter(str_detect(ybin,'78.8,100'))%>%select(count)\n",
    "\n",
    "\n",
    "away_final_third_succ=away_succ_passes_no_set%>%filter(x > 66.67 &endX >= 66.67)\n",
    "\n",
    "away_passes_into_pen=away_final_third_succ%>%filter(endX > 83 & endX < 100 & endY>100-87.8 & endY < 87.8 &!(x> 83 & x < 100 & y>100-87.8 & y < 87.8))\n",
    "\n",
    "\n",
    "away_key_passes =away_final_third_succ%>%filter(keyPass==1 )\n",
    "#Assists =KeyPasses%>% filter_all(any_vars(. %in% c('IntentionalGoalAssist')))\n",
    "\n",
    "away_assists =away_final_third_succ%>%filter(`type/displayName`==\"Pass\" & assist ==1 ) \n",
    "\n",
    "#away_append=rbind.data.frame(away_passes_into_pen,away_key_passes)\n",
    "\n",
    "# Removing duplicates\n",
    "away_unique_append <- unique(away_final_third_succ)\n",
    "\n",
    "\n",
    "away_breaking_points=c(0,78.8,63.2,36.8,21.1,100)\n",
    "\n",
    "away_unique_append$ybin <- cut(away_unique_append$y, breaks = away_breaking_points,include.lowest=TRUE )\n",
    "away_unique_append$x[away_unique_append$x>66.67] <- 66.67 \n",
    "away_unique_append$x[away_unique_append$x<100] <- 100 \n",
    "away_unique_append_zone_count= away_unique_append%>%group_by(ybin)%>%summarise(count=n())\n",
    "\n",
    "\n",
    "\n",
    "\n",
    "home_f3rd_annotations<- list(\n",
    "  annotate(\"text\",x = 63,y = 90,colour = \"white\",size = 7,label = str_glue(\"{if_else(home_unique_append_zone_count %>% filter(str_detect(ybin, '78.8,100')) %>% .$count == 0,'0',as.character(home_unique_append_zone_count %>% filter(str_detect(ybin, '78.8,100')) %>% .$count))} \\nfrom LWS\")),\n",
    "  annotate(\"text\",x = 63,y = 70,colour = \"white\",size = 7,label = str_glue(\"{if_else(home_unique_append_zone_count %>% filter(str_detect(ybin, '63.2,78.8')) %>% .$count == 0,'0',as.character(home_unique_append_zone_count %>% filter(str_detect(ybin, '63.2,78.8')) %>% .$count))} \\nfrom LHS\")),\n",
    "  annotate(\"text\",x = 63,y = 50,colour = \"white\",size = 7,label = str_glue(\"{if_else(home_unique_append_zone_count %>% filter(str_detect(ybin, '36.8,63.2')) %>% .$count == 0,'0',as.character(home_unique_append_zone_count %>% filter(str_detect(ybin, '36.8,63.2')) %>% .$count))} \\nfrom Centre\")),\n",
