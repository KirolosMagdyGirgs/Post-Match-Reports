   },
   "outputs": [],
   "source": [
    "\n",
    "#PROFILE\n",
    "file1 = \"passing_map.png\"                                       ####################################################################\n",
    "file2 = \"shots_map.png\"                             ####################################################################\n",
    "file3 = \"passes_received.png\"                                       ####################################################################\n",
    "file4 = \"player_image.png\"\n",
    "file5 = \"competition_image.png\"\n",
    "\n",
    "\n",
    "def merge1(file1, file2, file3): # add more images here if you want\n",
    "    # open all the files  (if you add more images, make sure to add them here too)\n",
    "    image1 = Image.open(file1)\n",
    "    image2 = Image.open(file2)\n",
    "    image3 = Image.open(file3)\n",
    "    if os.path.exists(file4) : image4 = Image.open(file4)\n",
    "    if os.path.exists(file5) : image5 = Image.open(file5)\n",
    "    #image6 = Image.open(file6)\n",
    "    \n",
    "    if os.path.exists(file4) : image4=image4.resize((500,550))\n",
    "    if os.path.exists(file5) : image5=image5.resize((420,420))\n",
    "    #image6 = image6.resize((500,500))\n",
    "\n",
    "    # get the width and height in pixels (if you add more images, make sure to add them here too)\n",
    "    (width1, height1) = image1.size\n",
    "    (width2, height2) = image2.size\n",
    "    (width3, height3) = image3.size\n",
    "    # print(image1.size)\n",
    "    # print(image2.size)\n",
    "    # print(image3.size)\n",
    "  \n",
    "\n",
    "    # here you're setting the final image's width and height.\n",
    "    # this one specifically is basically just for a 2x2 grid with all images the same size\n",
    "    result_width = width1+width2+width3\n",
    "    result_height = height1+600       #decide the \"end\" height of the imported photos\n",
    "    \n",
    "    # create image base\n",
    "    result = Image.new('RGB', (result_width, result_height), color='#262626')\n",
    "    # print(result.size)\n",
    "    \n",
    "    # Now the fun part, setting the images. KEY: box=(width, height)\n",
    "    # (if you add more images, make sure to add them here too)\n",
    "    result.paste(im=image1, box=(0, 350))   #decide the \"start\" height of the imported photos \n",
    "    result.paste(im=image2, box=(width1, 350))\n",
    "    result.paste(im=image3, box=(width1+width2,350))\n",
    "    if os.path.exists(file4) : result.paste(im=image4, box=(4800,0 ))   \n",
    "    if os.path.exists(file5) : result.paste(im=image5, box=(5400,80 )) \n",
    "   # result.paste(im=image6,box=(4800,3100))\n",
    "\n",
    "    return result\n",
    "\n",
    "img_PIL1=merge1(file1,file2,file3)\n",
    "t=ImageDraw.Draw(img_PIL1)\n",
    "myFont1 = ImageFont.truetype(\"D:/Projects/football analysis/BebasNeue-Regular.ttf\", 150)\n",
    "myFont2 = ImageFont.truetype(\"D:/Projects/football analysis/CaviarDreams.ttf\", 60)\n",
    "myFont3 = ImageFont.truetype(\"D:/Projects/football analysis/BebasNeue-Regular.ttf\", 70)\n",
    "\n",
    "\n",
    "#tilte\n",
    "title=f\"{Fotmob_player_name} vs {player_report_vs} | {competition_name} | {round}\"\n",
    "t.text((28, 36), title, font=myFont1,fill=\"white\")   \n",
    "\n",
    "\n",
    "#description\n",
    "t.text((28, 3470), \"*Progressive Pass :a pass that moves the ball closer \\nto the opponent goal by 25% & at least 5 m vertically.\", font=myFont2,fill=\"white\")\n",
    "t.text((28, 3650), \"*Key pass : pass that led to a shot.\", font=myFont2,fill=\"white\")\n",
    "\n",
