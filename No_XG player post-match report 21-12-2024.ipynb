    "\n",
    "SuccPassesHomeBFS=SuccPassesHome%>%filter(SuccPassesHome['minute']<FirstSubHome)\n",
    "SuccPassesAwayBFS=SuccPassesAway%>%filter(SuccPassesAway['minute']<FirstSubAway)\n",
    "\n",
    "\n",
    "\n",
    "\n",
    "MostRecipientsHome=SuccPassesHomeBFS%>%group_by(SuccPassesHomeBFS['recipient name'])%>%summarise(count=n())\n",
    "MostRecipientsAway=SuccPassesAwayBFS%>%group_by(SuccPassesAwayBFS['recipient name'])%>%summarise(count=n())\n",
    "\n",
    "\n",
    "AvgPosHome=SuccPassesHomeBFS%>%select('playerName','x','y')\n",
    "AvgPosHome=AvgPosHome%>%group_by(playerName)%>%summarise(x=mean(x),y=mean(y),passes_count=n())\n",
    "\n",
    "\n",
    "AvgPosAway=SuccPassesAwayBFS%>%select('playerName','x','y')\n",
    "AvgPosAway=AvgPosAway%>%group_by(playerName)%>%summarise(x=mean(x),y=mean(y),passes_count=n())\n",
    "\n",
    "\n",
    "\n",
    "PassesBetweenHome=SuccPassesHomeBFS%>%select('playerName','recipient name')\n",
    "PassesBetweenHome=PassesBetweenHome%>%group_by(playerName,PassesBetweenHome['recipient name'])%>%summarise(between_count=n())%>%filter(between_count>3)\n",
    "\n",
    "PassesBetweenAway=SuccPassesAwayBFS%>%select('playerName','recipient name')\n",
    "PassesBetweenAway=PassesBetweenAway%>%group_by(playerName,PassesBetweenAway['recipient name'])%>%summarise(between_count=n())%>%filter(between_count>3)\n",
    "\n",
    "\n",
    "\n",
    "pmh=merge(x=PassesBetweenHome,y=AvgPosHome,by=c(\"playerName\"))\n",
    "colnames(AvgPosHome)[1]='recipient name'\n",
    "pmh=merge(x=pmh,y=AvgPosHome,by=c('recipient name'))\n",
    "colnames(AvgPosHome)[1]='playerName'\n",
    "colnames(pmh)=c('recipient name','playerName','between_count','x','y','pass_count','end_x','end_y',\"end_count\")\n",
    "pmh=pmh[,c(2,1,3,4,5,6,7,8,9)]\n",
    "\n",
    "short=AvgPosHome%>%group_by(playerName)%>%summarise(short=sub(\":\", \" \", sub(\".* \", \"\", sub(\" (di|De|de|El|el|Da|da|Dos|dos|Van|van|Von|von|Le|le|La|la|N') \", \" \\\\1:\", unlist(data.frame(playerName))))))\n",
    "AvgPosHome=merge(x=AvgPosHome,y=unique(short),by=c(\"playerName\"))\n",
    "\n",
    "\n",
    "pma=merge(x=PassesBetweenAway,y=AvgPosAway,by=c(\"playerName\"))\n",
    "colnames(AvgPosAway)[1]='recipient name'\n",
    "pma=merge(x=pma,y=AvgPosAway,by=c('recipient name'))\n",
    "colnames(AvgPosAway)[1]='playerName'\n",
    "colnames(pma)=c('recipient name','playerName','between_count','x','y','pass_count','end_x','end_y',\"end_count\")\n",
    "pma=pma[,c(2,1,3,4,5,6,7,8,9)]\n",
    "\n",
    "short=AvgPosAway%>%group_by(playerName)%>%summarise(short=sub(\":\", \" \", sub(\".* \", \"\", sub(\" (di|De|de|El|el|Da|da|Dos|dos|Van|van|Von|von|Le|le|La|la|N') \", \" \\\\1:\", unlist(data.frame(playerName))))))\n",
    "AvgPosAway=merge(x=AvgPosAway,y=unique(short),by=c(\"playerName\"))\n",
    "#===================================================================================================================================\n",
    "#Pass end zones \n",
    "SuccPassesHome$xbin <- cut(SuccPassesHome$endX, breaks = seq(from=0, to=100, by = 20),include.lowest=TRUE )\n",
    "SuccPassesHome$ybin <- cut(SuccPassesHome$endY, breaks = seq(from=0, to=100, by = 20),include.lowest=TRUE )\n",
    "\n",
    "home_pass_end_zone_count= SuccPassesHome%>%group_by(xbin,ybin)%>%summarise(count=n())\n",
