    "\n",
    "#get it from network 'matchdetails matchid=' request\n",
    "#Scrape shots from fotmob \n",
    "\n",
    "#https://www.fotmob.com/matches/pachuca-vs-botafogo-rj/27qfw0\n",
    "#match_id=4662862\n",
    "#get the new id from sourc -> copy the link address of the file named after the id (not the number)\n",
    "url = f'https://www.fotmob.com/matches/stellenbosch-fc-vs-cd-lunda-sul/mvmysu3s'          ############################  CHANGE MATCH ID FROM FOTMOB###########################################\n",
    "response = requests.get(url)\n",
    "\n",
    "if response.status_code == 200:\n",
    "    data = response.text\n",
    "\n",
    "    # Accessing the shotmap\n",
    "    shotmap = data.split('matchId')\n",
    "    #print(shotmap)\n",
    "\n",
    "\n",
    "\n",
    "else:\n",
    "    print(\"Failed to retrieve data. Status Code:\", response.status_code)\n",
    "\n",
    "\n",
    "# #get shot mop\n",
    "# shot_map=pd.DataFrame(shotmap)\n",
    "# shot_map=shot_map.rename({'id':'fotmob_id'}, axis=1)\n",
    "# shot_map\n",
    "# shot_map.to_excel('D:/Projects/football analysis/23-24/Wessam abo ali/Shots.xlsx',index=False)\n",
    "\n",
    "f=response.text.split('shotmap' + '\":{\"shots\":[')[1]\n",
    "d=f.split(',\"lineup\":')[0]  #,\"lineup\":\n",
    "dd=d.split('],\"Periods\":')              #],\"Periods\":\n",
    "data=dd[0]\n",
    "\n",
    "data='['+data+']'\n",
    "data=json.loads(data)\n",
