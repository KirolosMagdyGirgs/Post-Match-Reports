    "home_team_def_actions_last60=data.source.xls %>% filter((((`type/displayName`==\"Tackle\"|`type/displayName`==\"Aerial\"|`type/displayName`==\"Foul\"|`type/displayName`==\"Interception\"|`type/displayName`==\"BlockedPass\")&`outcomeType/displayName`==\"Successful\")|`type/displayName`==\"Challenge\" ) \n",
