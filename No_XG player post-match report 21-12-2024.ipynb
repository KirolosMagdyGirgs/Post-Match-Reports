    "\n",
    "shots.to_excel(shots_data_source)\n",
    "\n",
    "\n",
    "r=response.text.split('{\"general\":')[1]\n",
    "r=r.split(',\"header\":')[0]  \n",
    "r=json.loads(r)\n",
    "r=pd.DataFrame(r)\n",
    "\n",
    "\n",
    "\n",
    "r['home_team_name']=r.loc['name']['homeTeam']\n",
    "r['home_team_id']=r.loc['id']['homeTeam']\n",
    "r['away_team_name']=r.loc['name']['awayTeam']\n",
    "r['away_team_id']=r.loc['id']['awayTeam']\n",
    "r.iloc[0]\n",
    "\n",
    "fotmob_match_details = pd.DataFrame(r.iloc[0]).transpose()\n",
    "\n",
    "\n",
    "fotmob_match_details[['homeColor', 'awayColor']] = fotmob_match_details['teamColors'].apply(lambda x: pd.Series([x['home'], x['away']]))\n",
    "#list(fotmob_match_details.columns)\n",
    "\n",
    "competition_name=fotmob_match_details['leagueName']['darkMode']\n",
    "round=fotmob_match_details['leagueRoundName']['darkMode']\n",
    "competition_id=fotmob_match_details['parentLeagueId']['darkMode']\n",
    "\n",
    "\n",
    "def save_image_from_url(image_url, save_path, background_color=(38, 38, 38)):\n",
    "    try:\n",
    "        # Make a GET request to the image URL\n",
    "        response = requests.get(image_url)\n",
    "\n",
    "        # Check if the request was successful (status code 200)\n",
    "        if response.status_code == 200:\n",
    "            # Open the image using PIL\n",
    "            image = Image.open(BytesIO(response.content))\n",
    "\n",
    "            # Convert image to RGBA if it has transparency\n",
    "            if image.mode in ('RGBA', 'LA') or (image.mode == 'P' and 'transparency' in image.info):\n",
    "                image = image.convert('RGBA')\n",
    "\n",
    "            # Create a new image with the specified background color\n",
    "            new_image = Image.new(\"RGBA\", image.size, background_color)\n",
    "            new_image.paste(image, (0, 0), image)\n",
    "\n",
    "            # Save the new image to the specified path as PNG\n",
    "            new_image.save(save_path, format='PNG')\n",
    "\n",
    "            print(f\"Image saved successfully at: {save_path}\")\n",
    "        else:\n",
    "            print(f\"Failed to retrieve image. Status code: {response.status_code}\")\n",
    "    except Exception as e:\n",
    "        print(f\"Error: {e}\")\n",
    "\n",
    "# Example usage                                                                            ####################################################################\n",
    "Fotmob_player_id=1221159\n",
    "player_image_url = f\"https://images.fotmob.com/image_resources/playerimages/{Fotmob_player_id}.png\"  ############ Replace with your FOTMOB PLAYER image URL###############3\n",
    "save_path = \"player_image.png\"          # Replace with your desired save path\n",
    "save_image_from_url(player_image_url , save_path)\n",
    "\n",
    "competition_image_url = f\"https://images.fotmob.com/image_resources/logo/leaguelogo/dark/{competition_id}.png\" ##### Replace with your FOTMOB COMPETTION image URL#################333\n",
    "save_path = \"competition_image.png\"   \n",
    "save_image_from_url(competition_image_url, save_path)\n",
    "\n",
    "# Assuming response.text contains the JSON-like string\n",
    "data = response.text.split(',\"lineup\":')[1].split(',\"playoff\"')[0]\n",
    "data = json.loads(data)\n",
    "\n",
    "# Extract home and away teams and their names\n",
    "home_team_name = data['homeTeam']['name']\n",
    "away_team_name = data['awayTeam']['name']\n",
    "home_team = data['homeTeam']['starters']\n",
    "away_team = data['awayTeam']['starters']\n",
    "\n",
    "# Function to get player details\n",
    "def get_player_details(Fotmob_player_id, home_team, away_team):\n",
    "    for player in home_team:\n",
    "        if player['id'] == Fotmob_player_id:\n",
    "            return player['name'], \"Home\", \"Starter\"\n",
    "    for player in away_team:\n",
    "        if player['id'] == Fotmob_player_id:\n",
    "            return player['name'], \"Away\", \"Starter\"\n",
    "    \n",
    "    # Check if the player is on the bench (substitute)\n",
    "    for player in data['homeTeam'].get('subs', []):\n",
    "        if player['id'] == Fotmob_player_id:\n",
    "            return player['name'], \"Home\", \"Substitute\"\n",
    "    for player in data['awayTeam'].get('subs', []):\n",
    "        if player['id'] == Fotmob_player_id:\n",
    "            return player['name'], \"Away\", \"Substitute\"\n",
    "    \n",
    "    return None, None, None  # If player is not found\n",
    "\n",
    "# Example usage\n",
    "\n",
    "player_name, team_status, player_status = get_player_details(Fotmob_player_id, home_team, away_team)\n",
    "\n",
    "\n",
    "Fotmob_player_name = player_name\n",
    "home_or_not = team_status\n",
    "player_report_vs = away_team_name  if team_status == 'Home' else home_team_name\n",
    "\n",
    "print(f\"Player Name: {Fotmob_player_name}\")\n",
    "print(f\"Team: {team_status} ({home_team_name if team_status == 'Home' else away_team_name})\")\n",
    "print(f\"vs: {player_report_vs}\")\n"
   ]
